/* HEARTS */
.heart{
  position:fixed;
  bottom:-20px;
  font-size:18px;
  animation:floatUp 6s linear infinite;
}
@keyframes floatUp{
  from{ transform:translateY(0); opacity:.6; }
  to{ transform:translateY(-110vh); opacity:0; }
}

footer{
