  max-width:90vw;
}
.center-circle{
  position:absolute;
  top:50%; left:50%;
  transform:translate(-50%,-50%);
  width:120px; height:120px;
  border-radius:50%;
  background:#ffb3d9;
  color:white;
  display:flex;
  align-items:center;
  justify-content:center;
  animation:pulseGlow 2.5s infinite;
  overflow:hidden;
  /* 🎯 ADD YOUR CENTER IMAGE/CANDLE HERE */
