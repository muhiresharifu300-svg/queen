<script>
function showSection(id){
  document.querySelectorAll('.section').forEach(s=>{
    s.classList.remove('active','fade');
  });
  const el=document.getElementById(id);
  if(el){
    el.classList.add('active');
    setTimeout(()=>el.classList.add('fade'),10);
  }
  if(id==="happybirth"){
    document.getElementById("birthdayPopup").style.display="flex";
  }
}

function closeBirthdayPopup(){
  document.getElementById("birthdayPopup").style.display="none";
}

/* Continuous rotation of circle images with words */
const centerX=200, centerY=200;
const ringRadius=140;
const items=document.querySelectorAll('.circle-item');
let angle=0;

function rotateCircleItems(){
  items.forEach((item,i)=>{
    const a=(i/items.length)*2*Math.PI + angle;
    item.style.left=centerX+ringRadius*Math.cos(a)-35+"px";
    item.style.top=centerY+ringRadius*Math.sin(a)-35+"px";
  });
  angle+=0.01; // rotation speed
  requestAnimationFrame(rotateCircleItems);
}
rotateCircleItems();

/* Floating hearts */
setInterval(()=>{
  const h=document.createElement("div");
  h.className="heart";
  h.innerHTML="💗";
  h.style.left=Math.random()*100+"vw";
  document.body.appendChild(h);
  setTimeout(()=>h.remove(),7000);
},1000);
</script>

