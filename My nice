  background-size: cover;
  background-position: center;
  box-shadow: 0 0 20px rgba(255,179,217,0.8);
}
.center-circle::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 179, 217, 0.3);
  border-radius: 50%;
}
.center-circle-text {
  position: relative;
  z-index: 1;
  font-weight: 700;
  font-size: 14px;
  text-align: center;
  text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
}
@keyframes pulseGlow{
  0%{ box-shadow:0 0 10px rgba(255,179,217,.6); }
  50%{ box-shadow:0 0 25px rgba(255,179,217,.9); }
  100%{ box-shadow:0 0 10px rgba(255,179,217,.6); }
}

/* ROTATING CIRCLE */
.circle-ring{
  position:absolute;
  width:100%;
  height:100%;
}

.circle-item{
  position:absolute;
  text-align:center;
}

.circle-item img{
  width:70px;
  height:70px;
  border-radius:50%;
  display:block;
  margin:auto;
  box-shadow: 0 4px 8px rgba(0,0,0,0.2);
}

.circle-item span{
  display:block;
  margin-top:6px;
  font-size:13px;
  color:#d63384;
  font-weight:600;
  background: rgba(255,255,255,0.8);
  padding: 2px 8px;
  border-radius: 4px;
}

/* POPUPS */
.popup{
  display:none;
  position:fixed;
  top:0; left:0;
  width:100%; height:100%;
  background:rgba(0,0,0,.8);
  justify-content:center;
  align-items:center;
  z-index:100;
}
.popup-content{
