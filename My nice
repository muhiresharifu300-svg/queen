<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />


<style>
:root{
  --blue:#1c4fd3;
  --bg:#f4f4ff;
}

body{
  margin:0;
  font-family:"Poppins",sans-serif;
  background:var(--bg);
  color:#222;
  text-align:center;
}

/* NAV */
nav{
  background:var(--blue);
  padding:15px;
  display:flex;
  justify-content:center;
  gap:25px;
  position:sticky;
  top:0;
  z-index:50;
  flex-wrap:wrap;
}
nav a{
  color:white;
  text-decoration:none;
  cursor:pointer;
  padding:6px 10px;
  border-radius:6px;
}
nav a:hover{ background:rgba(255,255,255,0.1); }

/* HEADER */
header{
  padding:26px 20px;
  background:linear-gradient(135deg,var(--blue),#5d95ff);
  color:white;
}
.subtitle{ margin-top:-8px; font-size:14px; }

/* SECTIONS */
.section{ display:none; }
.active{ display:block; }

/* FADE */
.fade{
  animation:fadeIn .7s ease forwards;
}
@keyframes fadeIn{
  from{ opacity:0; transform:translateY(12px); }
  to{ opacity:1; transform:translateY(0); }
}

/* GALLERY */
.gallery-outer{
  max-width:1200px;
  margin:30px auto;
}
.gallery-date{
  color:var(--blue);
  font-weight:700;
  font-size:15px;
  letter-spacing:1px;
  margin-top:10px;
}
.gallery{
  display:flex;
  gap:40px;
  justify-content:center;
  flex-wrap:wrap;
}
.image-box{
  width:320px;
  height:480px;
  border-radius:16px;
  overflow:hidden;
  box-shadow:0 12px 30px rgba(0,0,0,0.1);
  cursor:pointer;
  transition:.3s;
}
.image-box:hover{ transform:scale(1.04); }
.image-box img{
  width:100%;
  height:100%;
  object-fit:cover;
}
.image-box video{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}

/* CARD */
.card{
  background:white;
  margin:36px auto;
  padding:26px;
  border-radius:12px;
  width:85%;
  max-width:820px;
  text-align:left;
  box-shadow:0 8px 22px rgba(0,0,0,0.06);
}
.card h2{ color:var(--blue); }
.story-line{
  margin:0 0 4px 0;
}
.story-signoff{
  letter-spacing:4px;
  font-weight:700;
  margin-top:24px;
}

